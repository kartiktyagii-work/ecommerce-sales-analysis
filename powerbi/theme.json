{
  "name": "Northwind Margin",
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.114.json",

  "dataColors": [
    "#2a78d6",
    "#eb6834",
    "#1baf7a",
    "#eda100",
    "#e87ba4",
    "#008300",
    "#4a3aa7",
    "#e34948"
  ],

  "good": "#0ca30c",
  "neutral": "#898781",
  "bad": "#d03b3b",

  "minimum": "#d03b3b",
  "center": "#f0efec",
  "maximum": "#2a78d6",

  "background": "#fcfcfb",
  "secondaryBackground": "#f9f9f7",
  "foreground": "#0b0b0b",
  "secondaryForeground": "#52514e",
  "tableAccent": "#2a78d6",
  "hyperlink": "#256abf",

  "textClasses": {
    "title":       { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#0b0b0b" },
    "header":      { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0b0b0b" },
    "label":       { "fontFace": "Segoe UI",          "fontSize": 10, "color": "#52514e" },
    "callout":     { "fontFace": "Segoe UI",          "fontSize": 32, "color": "#0b0b0b" },
    "largeTitle":  { "fontFace": "Segoe UI Semibold", "fontSize": 18, "color": "#0b0b0b" }
  },

  "visualStyles": {
    "*": {
      "*": {
        "background":   [{ "show": true, "color": { "solid": { "color": "#fcfcfb" } }, "transparency": 0 }],
        "border":       [{ "show": true, "color": { "solid": { "color": "#e1e0d9" } }, "radius": 6 }],
        "visualHeader": [{ "show": true, "background": { "solid": { "color": "#fcfcfb" } } }],
        "title": [{
          "show": true,
          "fontColor":  { "solid": { "color": "#0b0b0b" } },
          "background": { "solid": { "color": "#fcfcfb" } },
          "alignment": "left",
          "fontSize": 12,
          "fontFamily": "Segoe UI Semibold"
        }],
        "categoryAxis": [{
          "show": true,
          "labelColor": { "solid": { "color": "#898781" } },
          "fontSize": 9,
          "gridlineShow": false,
          "showAxisTitle": false,
          "lineColor": { "solid": { "color": "#c3c2b7" } }
        }],
        "valueAxis": [{
          "show": true,
          "labelColor": { "solid": { "color": "#898781" } },
          "fontSize": 9,
          "gridlineShow": true,
          "gridlineColor": { "solid": { "color": "#e1e0d9" } },
          "gridlineThickness": 1,
          "gridlineStyle": "solid",
          "showAxisTitle": false
        }],
        "legend": [{
          "show": true,
          "position": "TopLeft",
          "showTitle": false,
          "labelColor": { "solid": { "color": "#52514e" } },
          "fontSize": 9
        }],
        "labels": [{
          "show": false,
          "color": { "solid": { "color": "#52514e" } },
          "fontSize": 9
        }]
      }
    },

    "card": {
      "*": {
        "labels":         [{ "color": { "solid": { "color": "#0b0b0b" } }, "fontSize": 28, "fontFamily": "Segoe UI" }],
        "categoryLabels": [{ "color": { "solid": { "color": "#52514e" } }, "fontSize": 10 }],
        "background":     [{ "show": true, "color": { "solid": { "color": "#fcfcfb" } } }],
        "border":         [{ "show": true, "color": { "solid": { "color": "#e1e0d9" } }, "radius": 6 }]
      }
    },

    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2, "showMarker": false }],
        "labels":     [{ "show": false }]
      }
    },

    "columnChart": { "*": { "labels": [{ "show": false }] } },
    "barChart":    { "*": { "labels": [{ "show": true, "color": { "solid": { "color": "#52514e" } }, "fontSize": 9 }] } },

    "scatterChart": {
      "*": {
        "fillPoint": [{ "show": true }],
        "categoryLabels": [{ "show": false }]
      }
    },

    "tableEx": {
      "*": {
        "grid": [{
          "gridVertical": false,
          "gridHorizontal": true,
          "gridHorizontalColor": { "solid": { "color": "#e1e0d9" } },
          "outlineColor": { "solid": { "color": "#e1e0d9" } },
          "rowPadding": 4
        }],
        "columnHeaders": [{
          "fontColor":  { "solid": { "color": "#0b0b0b" } },
          "backColor":  { "solid": { "color": "#f9f9f7" } },
          "fontFamily": "Segoe UI Semibold",
          "fontSize": 10
        }],
        "values": [{ "fontColor": { "solid": { "color": "#0b0b0b" } }, "fontSize": 10 }]
      }
    },

    "pivotTable": {
      "*": {
        "columnHeaders": [{ "fontColor": { "solid": { "color": "#0b0b0b" } }, "backColor": { "solid": { "color": "#f9f9f7" } }, "fontFamily": "Segoe UI Semibold", "fontSize": 10 }],
        "values":        [{ "fontColor": { "solid": { "color": "#0b0b0b" } }, "fontSize": 10 }],
        "grid":          [{ "gridVertical": false, "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#e1e0d9" } }, "rowPadding": 4 }]
      }
    },

    "slicer": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#f9f9f7" } } }],
        "border":     [{ "show": false }],
        "items":      [{ "fontColor": { "solid": { "color": "#52514e" } }, "fontSize": 10 }],
        "header":     [{ "show": true, "fontColor": { "solid": { "color": "#0b0b0b" } }, "fontSize": 10, "fontFamily": "Segoe UI Semibold" }]
      }
    },

    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#f9f9f7" } }, "transparency": 0 }]
      }
    }
  }
}
