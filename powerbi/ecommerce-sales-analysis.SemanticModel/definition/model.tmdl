model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["dim_date", "dim_customer", "dim_product", "dim_geography", "fact_order_line", "fact_return", "fact_target", "subcat_breakeven", "Discount Cap", "Survival Rate", "_Measures"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table dim_date
ref table dim_customer
ref table dim_product
ref table dim_geography
ref table fact_order_line
ref table fact_return
ref table fact_target
ref table subcat_breakeven
ref table 'Discount Cap'
ref table 'Survival Rate'
ref table _Measures

ref role Commercial
ref role 'West Regional Manager'
