		dataType: string
		summarizeBy: none
		sourceColumn: ship_mode

		annotation SummarizationSetBy = Automatic

	column ship_date_invalid
		dataType: boolean
		isHidden
		summarizeBy: none
		sourceColumn: ship_date_invalid

		annotation SummarizationSetBy = Automatic

	column sales
		dataType: decimal
		formatString: \$#,0;(\$#,0);\$#,0
		summarizeBy: sum
		sourceColumn: sales

		annotation SummarizationSetBy = Automatic

	column quantity
		dataType: int64
		formatString: #,0
		summarizeBy: sum
		sourceColumn: quantity

		annotation SummarizationSetBy = Automatic

	column discount
		dataType: decimal
		formatString: 0.00%;-0.00%;0.00%
		summarizeBy: none
