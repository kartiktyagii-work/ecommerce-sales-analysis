	column discount_band = ROUNDDOWN ( fact_order_line[discount] * 20, 0 ) / 20
		dataType: decimal
		formatString: 0%;-0%;0%
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fact_order_line = m
		mode: import
		source =
				let
				    Source = PostgreSQL.Database("127.0.0.1", "ecommerce"),
				    Data = Source{[Schema="core",Item="fact_order_line"]}[Data],
				    Typed = Table.TransformColumnTypes(Data, {{"order_line_key", Int64.Type},{"order_id", type text},{"date_key", type date},{"customer_key", Int64.Type},{"product_key", Int64.Type},{"geography_key", Int64.Type},{"ship_date", type date},{"ship_mode", type text},{"ship_date_invalid", type logical},{"sales", Currency.Type},{"quantity", Int64.Type},{"discount", Currency.Type},{"profit", Currency.Type},{"gross_list_value", Currency.Type},{"discount_value", Currency.Type},{"is_loss_making", type logical},{"is_returned", type logical}})
				in
